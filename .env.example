# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (SQLite for development, PostgreSQL for Docker/production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://archie_web_user:change-me@host.docker.internal:5432/archie_web_db

# Compose names (retain existing values when upgrading an installation)
COMPOSE_PROJECT_NAME=archie-web
REDIS_DATA_VOLUME=archie-web_redis_data

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# AI Agent (required for chat functionality)
AI_AGENT_URL=http://localhost:8005
# Browser-facing WebSocket URL for the AI Agent. Must be reachable from client
# devices, not just the server — use the host's LAN IP (e.g. ws://192.168.0.8:8005)
# instead of localhost when accessing Archie from other devices on the network.
AI_AGENT_URL_BROWSER=ws://localhost:8005

# Weather API (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweather-api-key-here

# Home Assistant MCP Server (Settings > Voice assistants > Expose, then
# Settings > Devices & services > Model Context Protocol Server)
HOMEASSISTANT_MCP_URL=http://homeassistant.local:8123/api/mcp
HOMEASSISTANT_MCP_TOKEN=your-ha-long-lived-access-token-here

# OpenAI (optional, for image generation)
OPENAI_API_KEY=your-openai-api-key-here

# Voice Assistant (optional)
PICOVOICE_ACCESS_KEY=your-picovoice-access-key-here
WAKE_WORD_FILE=archie-voice/hey-archie_en_linux_v3_0_0.ppn

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your-spotify-client-id-here
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret-here
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback/
# Populated automatically after completing the OAuth flow via /spotify/authorize/
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_REFRESH_TOKEN=
